# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Claude Code
.claude/

# pytest
.pytest_cache/
.coverage
htmlcov/

# Data folders
/Data/
/PlayByPlayLogs/
/RawData/
/Play by Play Logs.zip

# Generated training/testing reports (reporting code is tracked; outputs are not)
/reports/

# Trained model artifacts + preprocessed tensors (regenerated by training; not tracked)
/artifacts/
/data/processed/
# Cloud-upload tarballs / weight bundles / local report backups.
# Matched by pattern, not by name: naming them individually let v1.0-weights-lean.tgz
# (2.6 GB of weights) reach the index. Weights are regenerated by training, never tracked.
*.tgz
*.tar.gz
*.tar
*.zip

# Per-train state + logs written by `cviq> train --go` / train.py --state
/training/runs/

# Evaluation / test-run outputs (results/v<version>/<eval-name>/); regenerated, not tracked
/results/

# Eval-only run state (holdout ids + data paths); written by a full train, machine-local
/training/full_run_state.json

# Small-head training subset, derived from the state file above and equally machine-local.
# Deliberately NOT tracked: a fresh clone then carries no manifest, so full_run extracts one from
# that machine's own state and it cannot arrive stale.
/training/subset_games.json
